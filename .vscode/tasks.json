{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build Rust Workspace",
      "type": "shell",
      "command": "cargo",
      "args": ["build", "--workspace"],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "new"
      },
      "problemMatcher": ["$rustc"]
    },
    {
      "label": "Test Rust Workspace",
      "type": "shell",
      "command": "cargo",
      "args": ["test", "--workspace"],
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "new"
      },
      "problemMatcher": ["$rustc"]
    },
    {
      "label": "Clippy",
      "type": "shell",
      "command": "cargo",
      "args": ["clippy", "--workspace", "--", "-D", "warnings"],
      "presentation": {
        "reveal": "always",
        "panel": "new"
      },
      "problemMatcher": ["$rustc"]
    },
    {
      "label": "Format Rust",
      "type": "shell",
      "command": "cargo",
      "args": ["fmt", "--all"],
      "presentation": {
        "reveal": "silent"
      }
    },
    {
      "label": "Build Web",
      "type": "shell",
      "command": "npm",
      "args": ["run", "build"],
      "options": {
        "cwd": "${workspaceFolder}/apps/web"
      },
      "presentation": {
        "reveal": "always",
        "panel": "new"
      },
      "problemMatcher": []
    },
    {
      "label": "Test Web",
      "type": "shell",
      "command": "npm",
      "args": ["test", "--", "--watch=false"],
      "options": {
        "cwd": "${workspaceFolder}/apps/web"
      },
      "presentation": {
        "reveal": "always",
        "panel": "new"
      },
      "problemMatcher": []
    },
    {
      "label": "Dev Web",
      "type": "shell",
      "command": "npm",
      "args": ["run", "dev"],
      "options": {
        "cwd": "${workspaceFolder}/apps/web"
      },
      "isBackground": true,
      "presentation": {
        "reveal": "always",
        "panel": "new"
      },
      "problemMatcher": []
    },
    {
      "label": "Build All",
      "dependsOn": ["Build Rust Workspace", "Build Web"],
      "group": "build",
      "presentation": {
        "reveal": "always"
      }
    },
    {
      "label": "Test All",
      "dependsOn": ["Test Rust Workspace", "Test Web"],
      "group": "test",
      "presentation": {
        "reveal": "always"
      }
    },
    {
      "label": "Clean",
      "type": "shell",
      "command": "make",
      "args": ["clean"],
      "presentation": {
        "reveal": "always",
        "panel": "new"
      }
    }
  ]
}
