{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "lldb",
      "request": "launch",
      "name": "Debug Rust Test",
      "cargo": {
        "args": [
          "test",
          "--no-run",
          "--workspace"
        ],
        "filter": {
          "name": "${input:testName}",
          "kind": "test"
        }
      },
      "args": [],
      "cwd": "${workspaceFolder}"
    },
    {
      "type": "lldb",
      "request": "launch",
      "name": "Debug Rust Binary",
      "cargo": {
        "args": [
          "build",
          "--workspace"
        ]
      },
      "args": [],
      "cwd": "${workspaceFolder}"
    }
  ],
  "inputs": [
    {
      "id": "testName",
      "type": "promptString",
      "description": "Test name to debug",
      "default": "test_name"
    }
  ]
}
